{
  "name": "srijal/library-management-api",
  "type": "project",
  "description": "Laravel Library Management System REST API for Postman testing.",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^11.5",
    "mockery/mockery": ">=1.6 <2.0"
  },
  "autoload": {
    "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
  },
  "autoload-dev": {
    "psr-4": { "Tests\\": "tests/" }
  },
  "scripts": { "post-autoload-dump": ["@php artisan package:discover --ansi"] },
  "minimum-stability": "stable",
  "prefer-stable": true
}

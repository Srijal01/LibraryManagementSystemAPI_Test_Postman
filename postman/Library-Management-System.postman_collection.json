          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login successful\",()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.expect(j.token).to.exist;",
